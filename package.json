{
  "name": "pi-herdr-deck",
  "version": "0.1.0",
  "description": "Mouse-first Herdr side deck for controlling a running Pi session",
  "type": "module",
  "license": "MIT",
  "private": false,
  "os": [
    "linux"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bin": {
    "pi-herdr-deck": "./bin/pi-herdr-deck"
  },
  "files": [
    "bin",
    "dist/extensions",
    "dist/src",
    "herdr-plugin.toml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc",
    "test": "node --test dist/tests/unit/*.test.js",
    "test:unit": "node --test dist/tests/unit/*.test.js",
    "test:integration": "node --test dist/tests/integration/*.test.js",
    "smoke:package": "node scripts/package-smoke.mjs",
    "validate": "npm run typecheck && npm run build && npm run test:unit && npm run test:integration && npm run smoke:package"
  },
  "dependencies": {
    "@pi-herdr-deck/tui": "npm:@earendil-works/pi-tui@0.83.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": false
    },
    "@earendil-works/pi-tui": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "typescript": "5.8.3"
  },
  "pi": {
    "extensions": [
      "./dist/extensions/pi-herdr-deck.js"
    ]
  },
  "keywords": [
    "pi-package",
    "herdr-plugin",
    "pi",
    "herdr",
    "tui"
  ]
}
