{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jcfrags.local/pi-herdr-orchestrator/schemas/broker-protocol-v1.json",
  "title": "Broker Protocol Frames",
  "oneOf": [
    {
      "$ref": "#/$defs/hello"
    },
    {
      "$ref": "#/$defs/request"
    },
    {
      "$ref": "#/$defs/response"
    },
    {
      "$ref": "#/$defs/event"
    },
    {
      "$ref": "#/$defs/serverRequest"
    }
  ],
  "$defs": {
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "id", "client", "sessionKey", "auth"],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "hello"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name", "version", "capabilities"],
          "properties": {
            "kind": {
              "enum": ["deck", "cli", "pi_adapter", "test"]
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "capabilities": {
              "type": "array",
              "maxItems": 64,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "maxLength": 128
              }
            }
          }
        },
        "sessionKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{24}$"
        },
        "auth": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 5
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "id", "method", "params"],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "request"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "maxLength": 128
        },
        "params": {
          "type": "object"
        },
        "idempotencyKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "id", "method", "ok"],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "response"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "type": "string",
          "maxLength": 128
        },
        "ok": {
          "type": "boolean"
        },
        "result": {},
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code", "message", "retryable"],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
            },
            "message": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "retryable": {
              "type": "boolean"
            },
            "details": {
              "type": "object"
            },
            "remediation": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": true
              }
            }
          },
          "then": {
            "required": ["result"],
            "not": {
              "required": ["error"]
            }
          }
        },
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            }
          },
          "then": {
            "required": ["error"],
            "not": {
              "required": ["result"]
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "v",
        "type",
        "seq",
        "id",
        "event",
        "timestamp",
        "refs",
        "data"
      ],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "event"
        },
        "seq": {
          "type": "integer",
          "minimum": 1
        },
        "id": {
          "type": "string",
          "maxLength": 64
        },
        "event": {
          "type": "string",
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "refs": {
          "type": "object"
        },
        "data": {
          "type": "object"
        }
      }
    },
    "serverRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["v", "type", "id", "method", "params"],
      "properties": {
        "v": {
          "const": 1
        },
        "type": {
          "const": "server_request"
        },
        "id": {
          "$ref": "#/$defs/requestId"
        },
        "method": {
          "type": "string",
          "maxLength": 128
        },
        "params": {
          "type": "object"
        }
      }
    }
  }
}
