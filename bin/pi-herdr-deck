#!/usr/bin/env node

const minimum = [22, 19, 0];
const actual = process.versions.node.split(".").map(Number);
const supported =
  actual[0] > minimum[0] ||
  (actual[0] === minimum[0] && actual[1] > minimum[1]) ||
  (actual[0] === minimum[0] &&
    actual[1] === minimum[1] &&
    actual[2] >= minimum[2]);
if (!supported) {
  console.error(
    `pi-herdr-deck requires Node.js >=22.19.0; found ${process.versions.node}.`,
  );
  process.exitCode = 1;
} else if (process.platform !== "linux") {
  console.error("pi-herdr-deck version 0.1.0 supports Linux only.");
  process.exitCode = 1;
} else {
  console.error(
    "pi-herdr-deck is deprecated and retained for one release; use pi-herdr-orchestrator deck.",
  );
  const { main } = await import("../dist/src/deck/main.js");
  await main();
}
