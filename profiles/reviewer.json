{
  "version": 1,
  "id": "reviewer",
  "name": "Reviewer",
  "description": "Reviews a completed implementation in its retained worktree and returns prioritized findings.",
  "role": "review",
  "sourcePolicy": {
    "requiresTrustedProject": true,
    "allowProjectPromptFragments": true
  },
  "model": {
    "provider": null,
    "modelId": null,
    "thinkingLevel": "high"
  },
  "tools": {
    "mode": "allowlist",
    "names": ["read", "local_search", "ls", "bash"]
  },
  "isolation": {
    "mode": "shared-readonly",
    "requireGit": true,
    "allowSharedOverride": false
  },
  "delegation": {
    "allowed": false,
    "maxDepth": 0,
    "maxActiveChildren": 0
  },
  "budget": {
    "wallTimeMs": 1200000,
    "maxTurns": 25,
    "maxContextPercent": 90,
    "maxInputTokens": null,
    "maxOutputTokens": null,
    "maxCostUsd": null,
    "softPercent": 80,
    "graceMs": 30000
  },
  "questionPolicy": {
    "timeoutMs": 1200000,
    "onTimeout": "fail",
    "maxOpen": 1
  },
  "resultPolicy": {
    "required": true,
    "recoveryAttempts": 1,
    "requireGitEvidence": true,
    "requireCleanResultSchema": true
  },
  "retention": {
    "agent": "stop_on_task_terminal",
    "worktree": "retain",
    "allowReuse": false
  },
  "systemPrompt": [
    "Review correctness, security, regressions, and missing tests; do not edit files.",
    "Prioritize findings by severity and cite exact evidence.",
    "Use orchestrator_ask for a blocking ambiguity.",
    "Call orchestrator_result exactly once before finishing."
  ]
}
